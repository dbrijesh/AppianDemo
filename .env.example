# ── Runtime mode ──────────────────────────────────────────────────────────────
MGP_ENV=local                        # local | staging | production

# ── Database (swap to mssql+pyodbc://... for prod) ────────────────────────────
AUDIT_DB_URL=sqlite+aiosqlite:///./data/audit.db
IDENTITY_DB_URL=sqlite+aiosqlite:///./data/identity.db
ESIGN_DB_URL=sqlite+aiosqlite:///./data/esign.db
WORKFLOW_DB_URL=sqlite+aiosqlite:///./data/workflow.db
TASK_DB_URL=sqlite+aiosqlite:///./data/tasks.db
AGENT_DB_URL=sqlite+aiosqlite:///./data/agents.db

# ── Auth (stub for local; set AZURE_* for prod) ───────────────────────────────
AUTH_ADAPTER=stub                    # stub | azure_ad
JWT_SECRET=local-dev-secret-change-in-prod-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Azure AD (only needed when AUTH_ADAPTER=azure_ad)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUTHORITY=

# ── LLM (swap to vllm for prod) ───────────────────────────────────────────────
LLM_ADAPTER=ollama                   # ollama | vllm | openai
OLLAMA_BASE_URL=http://ollama:11434
VLLM_BASE_URL=
LLM_DEFAULT_MODEL=llama3.2
LLM_ALLOWED_MODELS=llama3.2,llama3.1,mistral
LLM_MAX_TOKENS=4096

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_ADAPTER=local                # local | minio | azure_blob
STORAGE_LOCAL_PATH=./data/files
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mgp-docs

# ── Service URLs (internal docker network) ───────────────────────────────────
AUDIT_CORE_URL=http://audit-core:8001
IDENTITY_URL=http://identity:8003
ESIGN_URL=http://esign:8002
WORKFLOW_URL=http://workflow-engine:8004
TASK_URL=http://task-service:8005
LLM_GATEWAY_URL=http://llm-gateway:8007

# ── Seeded admin credentials (local only) ─────────────────────────────────────
SEED_ADMIN_EMAIL=admin@mgp.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_OPERATOR_EMAIL=operator@mgp.local
SEED_OPERATOR_PASSWORD=Operator123!
SEED_QA_EMAIL=qa@mgp.local
SEED_QA_PASSWORD=QA123!
SEED_AUDITOR_EMAIL=auditor@mgp.local
SEED_AUDITOR_PASSWORD=Auditor123!

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
